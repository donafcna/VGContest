{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/noel/?",
      "dest": "/noel/play.html"
    },
    {
      "src": "/noel/play",
      "dest": "/noel/play.html"
    },
    {
      "src": "/noel/game",
      "dest": "/noel/game.html"
    },
    {
      "src": "/noel/online",
      "dest": "/noel/online.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/noel/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}